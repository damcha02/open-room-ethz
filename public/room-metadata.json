 "accessRules": {
  "checkedOn": "2026-11-17",
  "documents": [
   {
    "name": "Raumbenützungsreglement (RSETHZ 214.11), version of 2026-09-01",
    "url": "https://ethz.ch/content/dam/ethz/main/eth-zurich/organisation/rechtssammlung/214.11.pdf",
    "says": "Art. 5 lists the purposes of ordinary use (teaching, research, administration, official events). Art. 2: the unit a room is assigned to decides its use; the Rectorate decides for general teaching rooms. Self-study by students is neither listed nor prohibited."
   },
   {
    "name": "Richtlinien für die Benützung der Rektoratsräume (2010)",
    "url": "https://ethz.ch/content/dam/ethz/common/docs/weisungssammlung/files-de/rektoratsraeume-benuetzung.pdf",
    "says": "Regulates reservations and priorities (teaching has priority; separate rules for specific rooms remain reserved). It names HG F 30, HG G 60, MM C 78.1 and HIT E 51 as rooms not used for general teaching. It does not say whether students may use unbooked rooms."
   },
   {
    "name": "ETH Rauminfo room data",
    "url": "https://ethz.ch/bin/ethz/roominfo?path=/v2/rooms/<room>&lang=en",
    "says": "No field describes who may use a room. `responsible` and `orgunits` only name who manages it."
   }
  ],
  "conclusion": "No document confirms general student access to any room and none documents a student-specific restriction, so every room is unknown. Reservation status is never used to derive access."
