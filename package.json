{
  "name": "open-room-ethz",
  "private": true,
  "version": "1.0.0",
  "description": "Open Room ETHZ: find free ETH Zürich rooms from ETH's published reservation data (unofficial student project)",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "dev:worker": "wrangler dev",
    "test": "node --test",
    "test:e2e": "node e2e/run.mjs",
    "test:worker": "node worker-tests/run.mjs",
    "icons": "scripts/build-icons.sh",
    "stamp": "node scripts/stamp-version.mjs",
    "stamp:check": "node scripts/stamp-version.mjs --check",
    "metadata": "node scripts/build-room-metadata.mjs",
    "deploy": "node scripts/deploy.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.163.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/damcha02/open-room-ethz.git"
  }
}
